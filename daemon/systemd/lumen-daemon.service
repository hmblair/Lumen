# User unit (systemctl --user); survives logout because lingering is enabled.
# ExecStart points at the release binary built inside the repo clone.
[Unit]
Description=Lumen light daemon
After=network-online.target

[Service]
ExecStart=%h/dev/Lumen/daemon/target/release/lumen-daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
